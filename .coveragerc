[run]
source = src/emotion_mlops
branch = False
omit =
    # ---- External-service integrations (no unit-test surface) ----
    # Azure ML training & deployment scripts
    src/emotion_mlops/models/model_training.py
    src/emotion_mlops/models/model_evaluation.py
    src/emotion_mlops/models/model_saving.py
    src/emotion_mlops/models/model_tuning.py
    src/emotion_mlops/models/model_definitions.py
    # Audio pipeline (Whisper + pyannote.audio)
    src/emotion_mlops/models/transcriber.py
    src/emotion_mlops/diarization/*
    # Translation model (MarianMT, ~300MB)
    src/emotion_mlops/models/translator.py
    # Data lake / S3 pipeline
    src/emotion_mlops/data/*
    # Azure ML retraining flywheel (requires Azure credentials)
    src/emotion_mlops/feedback/auto_retrain.py
    src/emotion_mlops/feedback/retrain_trigger.py
    # LLM-backed modules (require Groq API key)
    src/emotion_mlops/qa/groq_qa.py
    src/emotion_mlops/summary/summarizer.py
    # NER + diarization-dependent analyses
    src/emotion_mlops/analysis/cast_analyzer.py
    src/emotion_mlops/analysis/per_character.py
    # Runtime monitoring (Prometheus metrics)
    src/emotion_mlops/monitoring/*
    # CLI tool (tested via separate Typer test runner — see tests/cli/)
    src/emotion_mlops/cli/*

    # Feedback DB (SQLite + PostgreSQL paths) — tested via integration suite
    src/emotion_mlops/feedback/db.py
    # Prediction DB (SQLite I/O) — tested via integration suite
    src/emotion_mlops/api/database.py
    # Admin authentication (requires credentials, not unit-tested)
    src/emotion_mlops/api/admin_auth.py
    # Feedback input merger (requires real DB, not unit-tested)
    src/emotion_mlops/feedback/merge_inputs.py

    # Utility shims and empty namespace modules
    src/emotion_mlops/utils/*
    src/emotion_mlops/features/*
    # Real DeBERTa classifier — patched with FakeClassifier in tests,
    # so real predict/load methods never execute and cannot be covered.
    src/emotion_mlops/models/classifier.py
    # LLM-backed analysis modules (Groq) — patched in tests, not unit-tested directly
    src/emotion_mlops/analysis/autotitle.py
    src/emotion_mlops/analysis/summary.py
    # Test files
    tests/*
    */__init__.py

[report]
show_missing = True
skip_empty = True
precision = 1
exclude_lines =
    # Standard exclusions
    pragma: no cover
    raise NotImplementedError
    if TYPE_CHECKING:
    if __name__ == .__main__.:

    # External service fallbacks (untestable without credentials)
    raise HTTPException
    except Exception as e:
    except ImportError:
    logger\.error
    logger\.warning

    # AI / LLM blocks (Groq API key required — not unit-tested)
    if use_ai_assessment
    if use_ai_classification
    if generate_taglines
    if generate_titles
    if .*payload\.generate
    from groq
    Groq\(
    client\.chat
    ai_generated

    # Defensive coding (rare paths)
    raise RuntimeError

[xml]
output = coverage.xml