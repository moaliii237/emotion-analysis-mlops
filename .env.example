# Example environment variables for EmotionScope.
# Copy to .env and fill in real values. Do NOT commit your .env.

# --- Database ---
# Postgres connection string. If unset, the app falls back to a local SQLite file.
DATABASE_URL=

# --- Model serving endpoint (Azure ML online endpoint) ---
ML_ENDPOINT_URL=
ML_ENDPOINT_KEY=
# Full scoring URI used in configs/azure_config.yaml (scoring_uri: "${SCORING_URI}")
SCORING_URI=

# --- API / frontend URLs ---
# Local API base used by the Streamlit frontend (dev).
API_URL=http://localhost:8000
# Production API base used by the Streamlit frontend (server deployment).
SERVER_API_URL=http://localhost:2001

# --- Admin dashboard login ---
# Required to log into the Monitor dashboard. If unset, a random password is
# generated per process (no usable login).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional: persist login tokens across restarts and set token lifetime (hours).
ADMIN_TOKEN_SECRET=
ADMIN_TOKEN_TTL_H=8

# --- Azure ML workspace ---
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_WORKSPACE_NAME=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_FEDERATED_TOKEN_FILE=

# --- Feedback flywheel ---
# Set to 1 to allow the /feedback endpoint to fire a live retrain automatically.
AUTO_RETRAIN_ENABLED=0

# --- External model / LLM services ---
GROQ_API_KEY=
GROQ_MODEL=
HF_TOKEN=
HUGGINGFACE_TOKEN=

# --- Optional model overrides ---
SUMMARIZER_MODEL=
DIARIZATION_MODEL=
